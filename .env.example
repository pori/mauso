# Copy to .env, fill in, and keep it at 600 permissions (owner-only) --
# matches this host's convention for every other credential file. Never
# commit the filled-in .env.

# Symmetric key mauso uses to encrypt provider API keys (LLM endpoint,
# Tavily for web_search) at rest before storing them in the mauso-data
# volume -- this is the ONLY thing MAUSO_SECRET_KEY protects; conversation
# content never reaches this backend's storage at all (see README.md).
# Generate one with:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAUSO_SECRET_KEY=

# Initial chat model, matching a model name your configured endpoint
# understands (e.g. a model_name from your LiteLLM config, or a model id
# from a hosted provider). Only takes effect until something is saved via
# the Settings page -- that always wins after. Can be left blank and set
# from Settings instead.
DEFAULT_CHAT_MODEL=

# Name of the pre-existing external Docker network docker-compose.yml joins
# (it must already have your LLM endpoint and ComfyUI reachable on it).
# Optional -- defaults to homellm_homellm if unset.
MAUSO_NETWORK=

# Base URL for the ComfyUI instance generate_image/edit_image call.
# Optional -- defaults to http://comfyui:8188 (i.e. a container named
# `comfyui` on MAUSO_NETWORK).
COMFYUI_BASE_URL=
